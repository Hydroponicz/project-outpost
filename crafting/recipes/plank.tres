[gd_resource type="Resource" script_class="RecipeData" format=3]

[ext_resource type="Script" path="res://crafting/recipe_data.gd" id="1_recipe"]
[ext_resource type="Script" path="res://crafting/item_amount.gd" id="2_amount"]
[ext_resource type="Resource" path="res://items/plank.tres" id="3_output"]
[ext_resource type="Resource" path="res://items/wood.tres" id="4_wood"]

[sub_resource type="Resource" id="Resource_wood"]
script = ExtResource("2_amount")
item = ExtResource("4_wood")
amount = 2

[resource]
script = ExtResource("1_recipe")
output = ExtResource("3_output")
output_amount = 1
ingredients = Array[ExtResource("2_amount")]([SubResource("Resource_wood")])
station = &""
