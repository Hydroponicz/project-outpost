[gd_scene format=3]

[ext_resource type="Script" path="res://ui/inventory_screen.gd" id="1_screen"]
[ext_resource type="Script" path="res://ui/drop_zone.gd" id="2_drop_zone"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.06, 0.06, 0.08, 0.92)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.35, 0.35, 0.4, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="InventoryScreen" type="CanvasLayer"]
layer = 2
script = ExtResource("1_screen")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.45)
script = ExtResource("2_drop_zone")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="Columns" type="HBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="InventoryColumn" type="VBoxContainer" parent="Center/Panel/Margin/Columns"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Center/Panel/Margin/Columns/InventoryColumn"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Inventory"

[node name="Grid" type="GridContainer" parent="Center/Panel/Margin/Columns/InventoryColumn"]
layout_mode = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6
columns = 8

[node name="Weight" type="Label" parent="Center/Panel/Margin/Columns/InventoryColumn"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Weight  0 / 300"

[node name="Hint" type="Label" parent="Center/Panel/Margin/Columns/InventoryColumn"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.55)
theme_override_font_sizes/font_size = 14
text = "Top row is your hotbar: keys 1-8, or LB / RB on gamepad."

[node name="CraftingColumn" type="VBoxContainer" parent="Center/Panel/Margin/Columns"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Center/Panel/Margin/Columns/CraftingColumn"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Crafting"

[node name="Recipes" type="VBoxContainer" parent="Center/Panel/Margin/Columns/CraftingColumn"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Info" type="Label" parent="Center/Panel/Margin/Columns/CraftingColumn"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.4, 1)
theme_override_font_sizes/font_size = 16

[node name="ChestColumn" type="VBoxContainer" parent="Center/Panel/Margin/Columns"]
visible = false
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Center/Panel/Margin/Columns/ChestColumn"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Chest"

[node name="Grid" type="GridContainer" parent="Center/Panel/Margin/Columns/ChestColumn"]
layout_mode = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6
columns = 8

[node name="HeldLabel" type="Label" parent="."]
visible = false
offset_right = 120.0
offset_bottom = 30.0
mouse_filter = 2
theme_override_colors/font_color = Color(1, 0.85, 0.4, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 18
